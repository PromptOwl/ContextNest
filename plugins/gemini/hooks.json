{
  "contextnest-lifecycle": {
    "SessionStart": [
      { "type": "command", "command": "node ./hooks/antigravity.js SessionStart", "timeout": 20 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "node ./hooks/antigravity.js PreInvocation", "timeout": 20 }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node ./hooks/antigravity.js PostToolUse", "timeout": 45 }
        ]
      }
    ],
    "Stop": [
      { "type": "command", "command": "node ./hooks/antigravity.js Stop", "timeout": 15 }
    ]
  }
}
